{
  "name": "js-scratchpad",
  "displayName": "JS Studio Scratchpad",
  "description": "Scratchpad local para JavaScript e TypeScript, sem IA, integrado ao JS Studio.",
  "version": "1.0.0",
  "publisher": "js-studio",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:scratchpad.open",
    "onCommand:scratchpad.new"
  ],
  "contributes": {
    "commands": [
      {
        "command": "scratchpad.open",
        "title": "Abrir Scratchpad JS/TS",
        "category": "JS Studio",
        "icon": "$(play)"
      },
      {
        "command": "scratchpad.new",
        "title": "Novo Scratchpad JS/TS",
        "category": "JS Studio",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "scratchpad.open",
          "group": "navigation",
          "when": "resourceExtname in .js, .jsx, .ts, .tsx"
        }
      ],
      "commandPalette": [
        {
          "command": "scratchpad.open",
          "when": "true"
        },
        {
          "command": "scratchpad.new",
          "when": "true"
        }
      ]
    },
    "keybindings": [
      {
        "command": "scratchpad.open",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n"
      }
    ]
  },
  "extensionKind": [
    "workspace"
  ]
}
